# Ejemplo de variables de entorno. Copiar a .env.local y completar con valores reales.
DB_HOST=localhost
DB_NAME=gestion_estacionamiento
DB_USER=gestion_user
DB_PASS=CHANGEME

APP_ENV=development
BASE_URL=http://localhost:8888/gestion-estacionamiento

# PostgreSQL usado por la app Next.js y las migraciones
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=gestion_estacionamiento
PGADMIN_USER=macbook
APP_DB_USER=app_estacionamiento
APP_DB_PASSWORD=generar-con-openssl-rand-base64-32

# Sesión firmada con jose (mínimo 48 caracteres)
AUTH_SECRET=generar-con-openssl-rand-base64-48

# Sólo para crear el primer administrador local
ADMIN_EMAIL=admin@estacionamiento.local
ADMIN_PASSWORD=CambiarEstaClaveLocal123
